<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <script>PLACEHOLDER_SCRIPT</script>
    <style>
        PLACEHOLDER_STYLESHEET
    </style>
    <style>
        :root {
            color-scheme: light dark !important;
        }

        html,
        body {
            overscroll-behavior: none !important;
            margin: 0 !important;
        }

        body::-webkit-scrollbar {
            display: none !important;
        }

        #markdown-rendered>*:first-child {
            margin-top: 0 !important;
        }

        #markdown-rendered>*:last-child {
            margin-bottom: 0 !important;
        }

        .code-block-wrapper {
            position: relative;
        }

        .copy-code-button {
            background-color: #f0f0f0;
            border: none;
            border-radius: 4px;
            font-size: 14px;
            cursor: pointer;
            opacity: 0;
            transition: opacity 0.2s ease-in-out;
        }

        .code-block-wrapper:hover .copy-code-button,
        .code-block-wrapper:focus-within .copy-code-button {
            opacity: 1;
        }

        .copy-code-button.copied {
            background-color: #4caf50;
            opacity: 0;
            transition: opacity 0.2s ease-in-out;
        }
    </style>
</head>

<body>
    <div id="markdown-rendered"></div>
    <script>
        function makeMarkdownRenderer() {
            return window.markdownit({
                highlight: function (str, lang) {
                    if (lang && hljs.getLanguage(lang)) {
                        try {
                            return hljs.highlight(str, {language: lang}).value
                        } catch (__) { }
                    } else {
                        try {
                            return hljs.highlightAuto(str).value
                        } catch (__) { }
                    }

                    return ''
                },
                linkify: true,
            })
                .use(window.markdownitMark)
                .use(window.markdownitTaskLists)
        }

        const markdownRenderedElement = document.getElementById('markdown-rendered')
        const ordinaryRenderer = makeMarkdownRenderer()
        let markdownRenderer = ordinaryRenderer
        let latestMarkdown
        let latestHtml
        let mathRequested = false

        function showMarkdown(html) {
            markdownRenderedElement.innerHTML = html
            addCopyButtons()
            latestHtml = html
        }

        function renderMarkdown(markdown) {
            try {
                return markdownRenderer.render(markdown)
            } catch (error) {
                if (markdownRenderer === ordinaryRenderer) throw error
                return ordinaryRenderer.render(markdown)
            }
        }

        function enableMath() {
            if (typeof window.texmath !== 'function' ||
                typeof window.katex?.renderToString !== 'function') return

            // Install into a separate renderer so a failed optional plugin
            // cannot leave new rules in the ordinary renderer.
            try {
                const mathRenderer = makeMarkdownRenderer()
                mathRenderer.use(window.texmath, {
                    engine: window.katex,
                    delimiters: ['dollars', 'brackets', 'doxygen', 'gitlab', 'julia', 'kramdown', 'beg_end'],
                    katexOptions: {
                        throwOnError: false,
                        errorColor: '#cc0000',
                    },
                })
                const mathHtml = mathRenderer.render(latestMarkdown)
                if (mathHtml !== latestHtml) showMarkdown(mathHtml)
                markdownRenderer = mathRenderer
            } catch (_) {}
        }

        function loadStylesheet(href, onLoad) {
            const stylesheet = document.createElement('link')
            stylesheet.rel = 'stylesheet'
            stylesheet.media = 'print'
            stylesheet.href = href
            stylesheet.addEventListener('load', () => {
                stylesheet.media = 'all'
                onLoad()
            }, { once: true })
            document.head.appendChild(stylesheet)
        }

        function loadScript(src, onLoad) {
            const script = document.createElement('script')
            script.src = src
            script.addEventListener('load', onLoad, { once: true })
            document.head.appendChild(script)
        }

        function requestMath() {
            if (mathRequested) return
            mathRequested = true
            const katex = 'https://cdn.jsdelivr.net/npm/katex@0.16.10/dist/katex.min'
            const texmath = 'https://cdn.jsdelivr.net/npm/markdown-it-texmath@1.0.0/'
            let pendingAssets = 3 // Two stylesheets and the ordered script chain.
            function assetLoaded() {
                pendingAssets -= 1
                if (pendingAssets === 0) enableMath()
            }
            loadStylesheet(katex + '.css', assetLoaded)
            loadStylesheet(texmath + 'css/texmath.min.css', assetLoaded)
            loadScript(katex + '.js', () => loadScript(texmath + 'texmath.min.js', assetLoaded))
        }

        window.updateWithMarkdownContentBase64Encoded = (markdownContentBase64Encoded) => {
            const markdownContent = decodeURIComponent(atob(markdownContentBase64Encoded).split(``).map(function (c) {return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);}).join(``));
            showMarkdown(renderMarkdown(markdownContent))
            latestMarkdown = markdownContent
            window.webkit.messageHandlers.renderedContentHandler.postMessage(markdownContentBase64Encoded)
            // Native sends its first Markdown after initial WebKit navigation.
            // Start optional requests only after acknowledging that rendering.
            requestMath()
        }

        function addCopyButtons() {
            const codeBlocks = document.querySelectorAll('pre');
            codeBlocks.forEach((codeBlock) => {
                const button = document.createElement('button');
                button.className = 'copy-code-button';
                button.type = 'button'
                button.textContent = 'Copy'
                button.addEventListener('click', () => {
                    window.webkit.messageHandlers.copyToPasteboard.postMessage(codeBlock.innerText)
                    button.textContent = 'Copied'
                    button.classList.add('copied')
                    setTimeout(() => {
                        button.textContent = 'Copy'
                        button.classList.remove('copied')
                    }, 2000)
                })
                const wrapper = document.createElement('div');
                wrapper.className = 'code-block-wrapper';
                codeBlock.parentNode.insertBefore(wrapper, codeBlock);
                wrapper.appendChild(codeBlock);
                wrapper.appendChild(button);
            });
        }


        const resizeObserver = new ResizeObserver((entries) => {window.webkit.messageHandlers.sizeChangeHandler.postMessage(entries[0].borderBoxSize[0].blockSize)});
        resizeObserver.observe(markdownRenderedElement);
    </script>
</body>

</html>
